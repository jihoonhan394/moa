# /etc/moa/moa.env 로 복사해 채운다. 권한은 0600, 소유자는 root.
#   sudo install -m 600 -o root -g root deploy/moa.env.example /etc/moa/moa.env
#
# ⚠️ 이 파일에 들어가는 값은 git·문서·메신저에 남기지 않는다.

# ── 데이터베이스 ──────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/db_moa
SPRING_DATASOURCE_USERNAME=moa
SPRING_DATASOURCE_PASSWORD=

# ── 자격증명 볼트의 마스터 키 (KEK) ───────────────────────────
# openssl rand -hex 32   으로 만든다. 64자 hex.
# ⚠️ 이 값을 잃으면 저장된 서버 비밀번호를 **아무도 복호화할 수 없다.** 금고·비밀번호 관리자에
#    따로 보관한다. 바꾸면 기존 자격증명을 못 읽는다.
MOA_VAULT_MASTER_KEY=

# ── 리버스 프록시 ─────────────────────────────────────────────
# nginx 가 한 대면 1. 이 값이 틀리면 로그인 잠금과 감사 기록의 출발지가 틀어진다.
#   0 으로 두면 모든 요청이 nginx IP 하나로 보여 **한 사람이 20번 틀리면 전체가 잠긴다.**
MOA_TRUSTED_PROXY_COUNT=1
# 컨테이너가 X-Forwarded-* 를 스스로 적용하지 못하게 한다. 그대로 none 을 유지한다.
MOA_FORWARD_HEADERS_STRATEGY=none
# 초대 메일 링크의 기준 주소. 프록시 뒤에서는 **반드시** 공개 주소를 넣는다.
MOA_BASE_URL=https://moa.example.co.kr
# HTTPS 뒤에 두면 켠다. 켜면 평문 연결에는 세션 쿠키가 실리지 않는다.
MOA_COOKIE_SECURE=true

# ── 최초 1회만 ────────────────────────────────────────────────
# 플랫폼 관리자(SYSTEM_ADMIN) 계정을 만든다. 로그인 경로는 은닉 경로 /platform 이다.
# 계정을 만든 뒤에는 **이 줄을 지우고 재시작**한다.
MOA_BOOTSTRAP_ADMIN_USERNAME=admin
MOA_BOOTSTRAP_ADMIN_PASSWORD=

# ── 데모 데이터 ───────────────────────────────────────────────
# 기본 false. 켜면 빈 DB 에 가짜 서버·사용자가 생긴다. 실제 사내 운영에서는 끈 채로 둔다.
MOA_SAMPLE_DATA_ENABLED=false

# ── 솔루션 헬스 체크 ─────────────────────────────────────────
# 등록된 솔루션의 포트·상태 명령을 주기적으로 확인해, 상태가 **바뀔 때** 담당자에게
# 인앱 알림 + 메일을 보낸다. 담당이 지정되지 않은 솔루션은 인프라·기관 관리자에게 간다.
#
# 시연·부하시험 중 알림이 끼어들면 안 될 때 false 로 끈다.
# MOA_HEALTH_ENABLED=true
# 배치 주기(ms). 연속 2회 실패에서 장애로 보므로 감지까지 약 2분이다.
# ⚠️ 솔루션이 수백 개면 한 바퀴가 이 값을 넘길 수 있다(접속 타임아웃 2초 × 솔루션 수).
#    fixedDelay 라 실행이 겹치지는 않지만, 그만큼 감지가 늦어진다 — 그때 주기를 늘린다.
# MOA_HEALTH_INTERVAL_MS=60000

# ── 선택: 웹 SSH/RDP 게이트웨이(Guacamole) ────────────────────
# MOA_GUACAMOLE_BASE_URL=http://127.0.0.1:8090
# MOA_GUACAMOLE_SECRET_KEY=
