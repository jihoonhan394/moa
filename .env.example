# Do not add a real password to this file.
# Tailscale must be connected before using the shared development DB host.
SPRING_DATASOURCE_URL=jdbc:postgresql://100.119.51.84:5432/db_your_account
SPRING_DATASOURCE_USERNAME=your_account
SPRING_DATASOURCE_PASSWORD=replace-with-your-db-password
SPRING_FLYWAY_ENABLED=false
# 기동 시 SYSTEM_ADMIN 계정(managed_users)을 보장한다. 값이 비면 시드를 건너뛴다.
MOA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-local-admin-password
# 선택: 부트스트랩 관리자 아이디(기본 admin)
#MOA_BOOTSTRAP_ADMIN_USERNAME=admin

# 웹 SSH/RDP 게이트웨이(Guacamole). deploy/guacamole/docker-compose.yml 로 로컬 실행.
# 두 값이 모두 있어야 서버 접속이 활성화된다. SECRET_KEY는 docker-compose의 JSON_SECRET_KEY와 동일해야 함.
MOA_GUACAMOLE_BASE_URL=http://localhost:8080/guacamole
# 128-bit 공유키(32 hex). 생성 예: openssl rand -hex 16
MOA_GUACAMOLE_SECRET_KEY=replace-with-32-hex-characters

# 자격증명 볼트 마스터 키(KEK). 256-bit(64 hex). 생성 예: openssl rand -hex 32
# 없으면 자격증명 저장/사용 시 실패한다. 실제값은 절대 커밋하지 말 것.
MOA_VAULT_MASTER_KEY=replace-with-64-hex-characters

# 선택: 데모 샘플 사용자 공통 비밀번호(8자 이상). 설정 시 dev.kim/ops.lee 등으로 로그인해 포털을 확인할 수 있다.
# 미설정 시 샘플 사용자는 임의 비밀번호(로그인 불가)로 생성된다.
#MOA_SAMPLE_USER_PASSWORD=replace-with-a-demo-password
